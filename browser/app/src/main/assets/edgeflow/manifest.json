{
  "manifest_version": 2,
  "name": "EdgeFlow Core",
  "version": "0.4.0",
  "description": "Built-in adaptive browser-wide performance engine for EdgeFlow Browser Aegis.",
  "browser_specific_settings": {
    "gecko": {
      "id": "edgeflow-core@edgeflow.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["global_optimizer.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["chatgpt.js"],
      "run_at": "document_start"
    }
  ]
}
