{
  "manifest_version": 2,
  "name": "EdgeFlow Core",
  "version": "0.1.0",
  "description": "Built-in performance engine for EdgeFlow Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "edgeflow-core@edgeflow.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["chatgpt.js"],
      "run_at": "document_start"
    }
  ]
}
